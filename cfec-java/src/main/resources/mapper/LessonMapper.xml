<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cfec.antiepidemic.mapper.LessonMapper">

    <select id="queryByTeacher" resultType="com.cfec.antiepidemic.entity.Lesson">
        select *
        from sys_lesson
        where user_id = #{id,jdbcType=BIGINT}
    </select>
    <select id="queryByDeptCode" resultType="com.cfec.antiepidemic.entity.Lesson">
        select *
        from sys_lesson
        where dept_id = #{code,jdbcType=VARCHAR}
    </select>
    <select id="queryByDeptCodeTwo" resultType="com.cfec.antiepidemic.entity.Lesson">
        select *
        from sys_lesson
        where dept_id like concat(#{code,jdbcType=VARCHAR}, '%')
    </select>
    <select id="getDeptByLessonId" resultType="java.lang.String">
        select dept_id
        from sys_lesson
        where id = #{lessonId,jdbcType=VARCHAR}
    </select>
</mapper>
